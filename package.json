    "build-subway-headsigns": "node scripts/build-subway-headsigns.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^2.2.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4",
