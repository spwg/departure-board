{
  "name": "departure-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:njt-test": "NJT_API_BASE_URL=https://testraildata.njtransit.com/api next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:node && npm run test:unit",
