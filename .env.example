# NJ Transit RailData API credentials, from
# https://developer.njtransit.com/registration
#
# These are the API credentials emailed to you on registration, not a
# njtransit.com website login. Without them the app serves stand-in departure
# and stop data, so it still runs.
NJT_API_USERNAME=
NJT_API_PASSWORD=

# Set to true for a local UI-only run. This always uses built-in fixture data,
# even when credentials exist in .env.local.
NJT_USE_FIXTURES=

# Free Upstash Redis database used to store and lock the shared NJT token.
# Create one at https://console.upstash.com/redis, then copy its REST API
# credentials here and into the matching Vercel project environments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guards /api/penn-positions/record, which the always-on collector calls to
# keep New York Penn history and the board log accruing. Any long random
# string. Unset, the route refuses every call.
CRON_SECRET=

# Set to true only on the always-on server (`next start`), never on Vercel: it
# starts a timer that loads the New York Penn board every 30 seconds.
# PENN_COLLECTOR=
# PENN_COLLECTOR_INTERVAL_SECONDS=30

# Leave unset for production RailData. To use NJ Transit's test backend, run
# `npm run dev:njt-test`; it supplies this value without changing this file.
# NJT_API_BASE_URL=https://testraildata.njtransit.com/api
