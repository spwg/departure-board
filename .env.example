# NJ Transit RailData API credentials, from
# https://developer.njtransit.com/registration
#
# These are the API credentials emailed to you on registration, not a
# njtransit.com website login. Without them the app serves stand-in departure
# and stop data, so it still runs.
NJT_API_USERNAME=
NJT_API_PASSWORD=

# Optional. NJ Transit's developer portal documents raildata.njt.gov, but that
# name has no A record yet; the default is the host that actually serves
# traffic. Set this to switch once the .gov host comes up.
# NJT_API_BASE_URL=https://raildata.njtransit.com/api
